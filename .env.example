# Optional public canonical origin, without a trailing slash. Leave empty during local development.
NEXT_PUBLIC_SITE_URL=

# Consultation delivery option 1: Resend. All three values are required.
# CONSULTATION_FROM_EMAIL must use a sender/domain verified with Resend.
# Never prefix these variables with NEXT_PUBLIC_.
RESEND_API_KEY=
CONSULTATION_FROM_EMAIL=
CONSULTATION_TO_EMAIL=

# Consultation delivery option 2: an HTTPS webhook controlled by your company.
# When configured, this is used instead of Resend. A 2xx response confirms receipt.
# Payload: { type, company, receivedAt, timezone, consultation }.
# The optional secret is sent as Authorization: Bearer <secret>.
# The receiver must retain or forward the inquiry before acknowledging it.
CONSULTATION_WEBHOOK_URL=
CONSULTATION_WEBHOOK_SECRET=

# Without a configured delivery option, the form returns an honest unavailable
# message and preserves entered details. No consultation request is simulated.
